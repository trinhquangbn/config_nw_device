! Cấu hình OSPF
! Biến: { process_id: 1, router_id: "1.1.1.1" (không bắt buộc),
!         networks: [{network: "10.0.12.0", wildcard: "0.0.0.3", area: 0}] }
! Nếu không khai báo router_id, thiết bị tự chọn IP lớn nhất làm router-id.
router ospf {{ process_id }}
{% if router_id is defined %}
 router-id {{ router_id }}
{% endif %}
{% for net in networks %}
 network {{ net.network }} {{ net.wildcard }} area {{ net.area }}
{% endfor %}
